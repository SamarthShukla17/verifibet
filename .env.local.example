# Solana cluster: "devnet" | "mainnet" (default devnet)
NEXT_PUBLIC_CLUSTER=devnet

# Overrides — normally sourced from lib/config.ts CONFIG[cluster], set here only to override
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=

# TxLINE — server-only secrets, never expose to the client. All calls go through app/api routes.
TXLINE_API_ORIGIN=https://txline-dev.txodds.com
TXLINE_JWT=
TXLINE_API_TOKEN=

# Keeper bot signing key (base58 secret key OR a JSON number[] array, server-only)
KEEPER_SECRET_KEY=

# Set to 1 to make keeper/resolver.ts build + sign + print resolve_market
# instead of sending it (byte-size asserted, never sent)
KEEPER_DRY_RUN=0

# Upstash Redis (keeper state / rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot (keeper CPI-validation-failure / tx-too-large alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret Helius echoes back as the literal `Authorization` header on
# every webhook POST to app/api/hooks/helius — must match the "Authentication
# Header" value configured on the Helius webhook itself.
HELIUS_WEBHOOK_AUTH_HEADER=

# Helius API key (devnet free tier) — better RPC reliability than the public
# devnet endpoint per CLAUDE.md's "Day 1" note. Not required for the webhook
# itself (Helius calls out to us), only if used as NEXT_PUBLIC_RPC_URL.
HELIUS_API_KEY=

# Base URL keeper/resolver.ts uses to log a clickable receipt link
# (defaults to http://localhost:3000 if unset)
NEXT_PUBLIC_APP_URL=

# Where app/api/keeper/status can reach the keeper process's own
# :8787/healthz (defaults to http://localhost:8787/healthz — only needs
# overriding once the keeper runs as a separate deployed process)
KEEPER_HEALTHZ_URL=

# Demo mode: 0 = live TxLINE data, 1 = scripted demo-data playback
DEMO_MODE=0
DEMO_SPEED=60
