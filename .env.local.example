# Solana cluster: "devnet" | "mainnet" (default devnet)
NEXT_PUBLIC_CLUSTER=devnet

# Overrides — normally sourced from lib/config.ts CONFIG[cluster], set here only to override
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=

# TxLINE — server-only secrets, never expose to the client. All calls go through app/api routes.
TXLINE_API_ORIGIN=https://txline-dev.txodds.com
TXLINE_JWT=
TXLINE_API_TOKEN=

# Keeper bot signing key (base58 secret key, server-only)
KEEPER_SECRET_KEY=

# Upstash Redis (keeper state / rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot (keeper/admin alerts)
TELEGRAM_BOT_TOKEN=

# Demo mode: 0 = live TxLINE data, 1 = scripted demo-data playback
DEMO_MODE=0
DEMO_SPEED=60
